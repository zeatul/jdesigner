<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30">
    <Appenders>
        <Console name="CONSOLE" target="SYSTEM_OUT">
            <PatternLayout
                pattern="%d{yyyy-MM-hh HH:mm:ss.SSS}  %t %highlight{%5level}{ERROR=red,WARN=yellow,DEBUG=green,TRACE=cyan,INFO=magenta} %c{1.}.%M %L %msg%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <Logger name="glz.hawkframework" level="DEBUG" additivity="false">
            <AppenderRef ref="CONSOLE"/>
        </Logger>

        <Logger name="org.apache.ibatis" level="DEBUG" additivity="false">
            <AppenderRef ref="CONSOLE"/>
        </Logger>

        <Root level="ERROR">
            <AppenderRef ref="CONSOLE"/>
        </Root>
    </Loggers>
</Configuration>
